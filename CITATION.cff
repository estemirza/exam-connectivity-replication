    given-names: "Moch Mirza Ilham"
    orcid: "https://orcid.org/0009-0001-1013-9415"
    affiliation: "Yayasan Al-Khawarizmi; Universitas Ciputra"
keywords:
  - online assessment
  - intermittent connectivity
  - educational technology
  - learning for development
  - offline-first
  - Indonesia
